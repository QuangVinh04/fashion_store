{
  "realm": "fashion-store",
  "displayName": "Fashion Store",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 300,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "smtpServer": {
    "host": "${MAIL_HOST:smtp.gmail.com}",
    "port": "${MAIL_PORT:587}",
    "from": "${MAIL_FROM:no-reply@fashion.local}",
    "fromDisplayName": "Fashion Store",
    "auth": "true",
    "starttls": "true",
    "user": "${MAIL_USERNAME:}",
    "password": "${MAIL_PASSWORD:}"
  },
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "USER",
        "description": "Khách hàng đã đăng ký"
      },
      {
        "name": "ADMIN",
        "description": "Quản trị viên backoffice",
        "composite": true,
        "composites": {
          "realm": [
            "USER"
          ]
        }
      },
      {
        "name": "default-roles-fashion-store",
        "description": "Role mặc định gán cho mọi user mới",
        "composite": true,
        "composites": {
          "realm": [
            "USER",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ],
    "client": {
      "fashion-api": [
        {
          "name": "product:write",
          "description": "Tạo/sửa/xoá sản phẩm"
        },
        {
          "name": "internal-caller",
          "description": "Service account được gọi /internal/**"
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-fashion-store"
  },
  "clients": [
    {
      "clientId": "fashion-api",
      "name": "Fashion Store API",
      "description": "Audience + client roles cho các resource server. Không dùng để đăng nhập.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "storefront-bff",
      "name": "Storefront BFF",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${STOREFRONT_BFF_CLIENT_SECRET:dev-storefront-bff-secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8083/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8083/*"
      },
      "protocolMappers": [
        {
          "name": "fashion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fashion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "fashion-api",
            "claim.name": "resource_access.fashion-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "backoffice-bff",
      "name": "Backoffice BFF",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BACKOFFICE_BFF_CLIENT_SECRET:dev-backoffice-bff-secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8084/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8084/*"
      },
      "protocolMappers": [
        {
          "name": "fashion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fashion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "fashion-api",
            "claim.name": "resource_access.fashion-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swagger-ui",
      "name": "Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "fashion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fashion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "order-service (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ORDER_SERVICE_CLIENT_SECRET:dev-order-service-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "fashion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fashion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "catalog-service",
      "name": "catalog-service (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CATALOG_SERVICE_CLIENT_SECRET:dev-catalog-service-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "fashion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fashion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "identity-service",
      "name": "identity-service (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IDENTITY_SERVICE_CLIENT_SECRET:dev-identity-service-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "fashion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fashion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "clientRoles": {
        "fashion-api": [
          "internal-caller"
        ]
      }
    },
    {
      "username": "service-account-catalog-service",
      "enabled": true,
      "serviceAccountClientId": "catalog-service",
      "clientRoles": {
        "fashion-api": [
          "internal-caller"
        ]
      }
    },
    {
      "username": "service-account-identity-service",
      "enabled": true,
      "serviceAccountClientId": "identity-service",
      "clientRoles": {
        "fashion-api": [
          "internal-caller"
        ]
      }
    },
    {
      "username": "admin@fashion.local",
      "email": "admin@fashion.local",
      "firstName": "Admin",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@12345",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-fashion-store",
        "ADMIN"
      ],
      "clientRoles": {
        "fashion-api": [
          "product:write"
        ]
      }
    },
    {
      "username": "customer@fashion.local",
      "email": "customer@fashion.local",
      "firstName": "Customer",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Customer@12345",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-fashion-store"
      ]
    }
  ]
}
