# Biến cho docker-compose.prod.yml. Copy sang .env.prod (không commit), điền giá trị thật.
# Thiếu biến nào thì `docker compose ... up` dừng với thông báo "<VAR> is required".
# Sinh secret: openssl rand -base64 32

# URL công khai (HTTPS, không có dấu / cuối) mà browser thấy qua reverse proxy
KEYCLOAK_HOSTNAME=https://auth.example.com
STOREFRONT_BFF_PUBLIC_URL=https://shop.example.com
BACKOFFICE_BFF_PUBLIC_URL=https://admin.example.com
STOREFRONT_UI_URL=
BACKOFFICE_UI_URL=

# Keycloak
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=

# Client secret (phải khớp realm; realm đã import thì đổi trong admin console)
STOREFRONT_BFF_CLIENT_SECRET=
BACKOFFICE_BFF_CLIENT_SECRET=
ORDER_SERVICE_CLIENT_SECRET=
CATALOG_SERVICE_CLIENT_SECRET=
IDENTITY_SERVICE_CLIENT_SECRET=
PAYMENT_SERVICE_CLIENT_SECRET=

# SMTP gửi email xác minh / quên mật khẩu. Dùng nhà cung cấp transactional (SES, SendGrid, Postmark…),
# MAIL_FROM thuộc domain đã cấu hình SPF/DKIM/DMARC.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=no-reply@example.com
MAIL_USERNAME=
MAIL_PASSWORD=

# Session BFF trong Redis; để rỗng nếu Redis không đặt mật khẩu (vẫn phải khai báo)
REDIS_PASSWORD=
