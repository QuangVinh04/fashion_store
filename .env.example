# Local Docker Compose configuration. Copy to .env and replace values as needed.
# This file contains development defaults only; never put real credentials here.

# Frontend URLs
STOREFRONT_UI_URL=http://host.docker.internal:3000
BACKOFFICE_UI_URL=http://host.docker.internal:5173
FRONTEND_URL=http://localhost:3000

# Keycloak and internal OAuth clients (must match the imported realm)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
STOREFRONT_BFF_CLIENT_SECRET=dev-storefront-bff-secret
BACKOFFICE_BFF_CLIENT_SECRET=dev-backoffice-bff-secret
IDENTITY_SERVICE_CLIENT_SECRET=dev-identity-service-secret
CATALOG_SERVICE_CLIENT_SECRET=dev-catalog-service-secret
ORDER_SERVICE_CLIENT_SECRET=dev-order-service-secret

# SMTP (leave credentials empty until an SMTP account is configured)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=no-reply@fashion.local
MAIL_USERNAME=
MAIL_PASSWORD=

# GHN shipping. Enable only after setting the account-specific values below.
GHN_ENABLED=false
GHN_ALLOW_MOCK=false
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=0
GHN_FROM_DISTRICT_ID=0
GHN_FROM_WARD_CODE=0
GHN_WEBHOOK_TOKEN=dev-ghn-webhook-secret

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
